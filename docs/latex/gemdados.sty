\newcolumntype{Y}{>{\raggedright\arraybackslash}X}
\newcolumntype{L}[1]{>{\raggedright\arraybackslash}p{#1}}

\newtcolorbox{gemnote}[1][Nota]{
  colback=GEMLight,
  colframe=GEMBlue,
  coltitle=white,
  title=\textbf{#1},
  arc=1.5mm,
  boxrule=0.7pt,
  left=3mm,right=3mm,top=2mm,bottom=2mm,
  before upper=\raggedright
}

\newtcolorbox{gemwarning}[1][Atenção]{
  colback=GEMPale,
  colframe=GEMAmber,
  coltitle=white,
  title=\textbf{#1},
  arc=1.5mm,
  boxrule=0.7pt,
  left=3mm,right=3mm,top=2mm,bottom=2mm,
  before upper=\raggedright
}

\newcommand{\code}[1]{#1}

\newcommand{\GemCover}[3]{%
  \begin{titlepage}
    \thispagestyle{empty}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[GEMDark] (current page.north west) rectangle ([yshift=-20mm]current page.north east);
      \fill[GEMBlue] (current page.south west) rectangle ([xshift=10mm]current page.north west);
      \draw[GEMBlue!12,line width=1pt]
        ([xshift=-8mm,yshift=15mm]current page.south east) --
        ([xshift=-36mm,yshift=44mm]current page.south east) --
        ([xshift=-8mm,yshift=73mm]current page.south east);
      \draw[GEMBlue!12,line width=1pt]
        ([xshift=-28mm,yshift=6mm]current page.south east) --
        ([xshift=-56mm,yshift=35mm]current page.south east) --
        ([xshift=-28mm,yshift=64mm]current page.south east);
    \end{tikzpicture}
    \vspace*{27mm}
    \begin{center}
      \includegraphics[width=0.66\textwidth]{assets/gemdados-logo.png}
    \end{center}
    \vfill
    \hspace{6mm}\begin{minipage}{0.88\textwidth}
      {\fontsize{28}{32}\selectfont\bfseries\color{GEMDark}#1\par}
      \vspace{5mm}
      {\Large\color{GEMBlue}#2\par}
      \vspace{9mm}
      {\normalsize\color{GEMGray}#3\par}
    \end{minipage}
    \vfill
    \hspace{6mm}{\small\textcolor{GEMGray}{GEM Dados - Grupo de Estudos e Mentoria em Dados}}
    \vspace*{12mm}
  \end{titlepage}
}

