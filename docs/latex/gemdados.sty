\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textbf{GEM} \textcolor{GEMBlue}{DADOS}}
\fancyhead[R]{\small\textcolor{GEMGray}{\DocumentKind}}
\fancyfoot[L]{\footnotesize\textcolor{GEMGray}{Versão \DocumentVersion{} - setembro de 2026}}
\fancyfoot[R]{\footnotesize\textcolor{GEMGray}{\thepage/\pageref*{LastPage}}}
\renewcommand{\headrulewidth}{0.6pt}
